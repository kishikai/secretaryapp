# Copy to .env and fill in ONE of the two set-ups. See docs/deploy.md.

# A. Tailscale (private, recommended): docker compose -f compose.tailscale.yaml up -d --build
#    Make an auth key at https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-...
TS_HOSTNAME=secretary

# B. Public internet with your own domain (Caddy gets HTTPS): docker compose up -d --build
# SITE_ADDRESS=secretary.example.org
# SECRETARY_COOKIE_SECURE=1
